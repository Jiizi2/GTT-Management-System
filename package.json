{
  "name": "typescript-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "A workspace monorepo with separate frontend and backend apps.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "clean:test:coverage": "node apps/frontend/scripts/clean-output.mjs coverage/unit coverage/smoke/frontend .nyc_output/backend-unit",
    "lint:frontend": "npm run lint --workspace frontend",
    "format:frontend": "npm run format --workspace frontend",
    "format:check:frontend": "npm run format:check --workspace frontend",
    "format:write:frontend": "npm run format:write --workspace frontend",
    "start:backend": "npm run start --workspace backend",
    "check": "npm run check --workspaces",
    "test:unit": "npm run test:unit --workspaces",
    "test:unit:watch:frontend": "npm run test:unit:watch --workspace frontend",
    "test:unit:coverage": "npm run clean:test:coverage && npm run test:unit:coverage --workspace backend && npm run test:unit:coverage --workspace frontend",
    "test:unit:coverage:check": "npm run clean:test:coverage && npm run test:unit:coverage:check --workspace backend && npm run test:unit:coverage:check --workspace frontend",
    "test:smoke": "npm run test:smoke --workspace frontend",
    "test:backup-safety": "node --test scripts/production-backup.test.mjs",
    "test:component:frontend": "npm run test:component --workspace frontend",
    "test:smoke:coverage:frontend": "npm run test:smoke:coverage --workspace frontend",
    "test:smoke:watch:frontend": "npm run test:smoke:watch --workspace frontend",
    "test:api": "npm run test:api --workspace backend",
    "test:integration": "npm run test:integration --workspace backend",
    "test:restore-safety": "node --test scripts/db-restore-local.test.mjs scripts/production-backup.test.mjs",
    "test:integration-guard": "npm run test:integration:guard --workspace backend",
    "test:prisma": "npm run test:integration --workspace backend",
    "test": "npm run test:unit",
    "test:all": "npm run test --workspaces",
    "test:e2e:frontend": "npm run build:backend && npm run build:frontend && npm run test:e2e:frontend:run",
    "test:e2e:frontend:run": "npm run test:e2e --workspace frontend",
    "verify": "npm run check && npm run lint:frontend && npm run test && npm run build",
    "qa": "npm run qa:quick",
    "qa:quick": "npm run verify && npm run test:restore-safety && npm run test:integration-guard && npm run test:smoke && npm run test:api",
    "qa:full": "npm run qa:quick && npm run test:component:frontend && npm run test:prisma && npm run test:e2e:frontend:run",
    "db:generate:backend": "npm run db:generate --workspace backend",
    "db:status:backend": "npm run db:status --workspace backend",
    "db:deploy:backend": "npm run db:deploy --workspace backend",
    "db:migrate:backend": "npm run db:migrate --workspace backend",
    "db:seed:backend": "npm run db:seed --workspace backend",
    "db:studio:backend": "npm run db:studio --workspace backend",
    "db:restore:local": "node scripts/db-restore-local.mjs",
    "db:backup:production": "node scripts/production-backup.mjs --kind scheduled",
    "db:backup:predeploy": "node scripts/production-backup.mjs --kind predeploy",
    "db:backup:freshness": "node scripts/backup-freshness.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "c8": "^11.0.0",
    "jsdom": "^22.1.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}

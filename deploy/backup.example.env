# Install as /etc/gtt/backup.env with mode 0600. Do not commit the real file.
BACKUP_STAGING_DIR=/var/lib/gtt-backup/staging
BACKUP_STATE_FILE=/var/lib/gtt-backup/last-success.json
BACKUP_AGE_RECIPIENTS_FILE=/run/secrets/gtt-backup-recipients.txt
BACKUP_RCLONE_REMOTE=s3:gtt-production-backups
RCLONE_CONFIG=/etc/gtt/rclone.conf
BACKUP_COMPOSE_FILE=/opt/gtt/docker-compose.prod.yml
BACKUP_MAX_AGE_HOURS=7
# Incoming webhook owned by Operations; the real URL is a secret.
BACKUP_ALERT_WEBHOOK_URL=https://monitoring.example.invalid/hooks/replace-me
POSTGRES_DB=gtt_ops
RELEASE_SHA=replace-at-deploy-time

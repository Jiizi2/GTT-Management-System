# Backend production environment for docker-compose on a VPS.
# Copy to: apps/backend/.env on the production host.
# DATABASE_URL is injected by docker-compose.prod.yml and points to the `postgres` service.
# Review the values below before first deploy.

NODE_ENV=production
PORT=3001
DATA_SOURCE=prisma

# Required: use a real random secret with at least 32 characters.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Must stay false in production.
AUTH_BOOTSTRAP_DEFAULT_USERS=false

# Required: exact browser origin that will open the app.
# Example with domain: CORS_ORIGINS="https://app.example.com"
# Example while testing via VPS IP and port: CORS_ORIGINS="http://123.123.123.123:8080"
CORS_ORIGINS="https://app.example.com"

# Recommended when backend is behind Nginx/reverse proxy.
TRUST_PROXY=true

# Optional: only set this if you need cookie sharing across subdomains.
# AUTH_COOKIE_DOMAIN=".example.com"

# Reasonable production defaults.
LOG_LEVEL=info
HTTP_LOG_SUCCESS=true
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
AUTH_LOGIN_RATE_LIMIT_LOCK_MS=300000
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_DEFAULT_BLOCK_MS=60000
RUNTIME_RETENTION_ENABLED=true
RUNTIME_RETENTION_INTERVAL_MS=3600000
GROUP_AUDIT_LOG_RETENTION_DAYS=180
AUTH_LOGIN_RATE_LIMIT_RETENTION_DAYS=14
APP_THROTTLE_BUCKET_RETENTION_DAYS=14

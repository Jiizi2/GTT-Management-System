# Backend production environment
# Copy to: apps/backend/.env on production host

NODE_ENV=production
PORT=3001
DATA_SOURCE=prisma
DATABASE_URL="postgresql://db_user:db_password@db_host:5432/gtt_ops?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
AUTH_BOOTSTRAP_DEFAULT_USERS=false
CORS_ORIGINS="https://app.example.com,https://www.app.example.com"
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
AUTH_LOGIN_RATE_LIMIT_LOCK_MS=300000

# Optional: only used if AUTH_BOOTSTRAP_DEFAULT_USERS=true
DEV_AUTH_SUPERADMIN_PASSWORD="change-if-bootstrap-enabled"
DEV_AUTH_ADMIN_PASSWORD="change-if-bootstrap-enabled"

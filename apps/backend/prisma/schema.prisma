generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupTone {
  ACTIVE
  INACTIVE
}

enum GroupLifecycleStatus {
  ENTRY_ONLY
  ACTIVE
  INACTIVE
  COMPLETED
  ARCHIVED
}

enum VisaStatus {
  DRAFT
  PENDING
  ISSUED
}

enum VisaPaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

enum VisaBusStatus {
  VISA_ONLY
  VISA_PLUS
}

enum AgreementApprovalStatus {
  WAITING
  APPROVED
  REJECTED
}


enum AgreementCity {
  MAKKAH
  MADINAH
}

enum GroupRaudhahStatus {
  FREE
  AFTER
  BEFORE
}

enum ChecklistAssignmentStatus {
  NOT_COMPLETE
  ASSIGNED
}

enum InvoiceStatus {
  PAID
  PARTIALLY_PAID
  PENDING
  OVERDUE
  CANCELLED
}

enum AuthUserRole {
  SUPER_ADMIN
  ADMIN
  FINANCE_MANAGER
  CUSTOMER_SUPPORT
}

model AuthUser {
  id           String       @id @default(cuid())
  name         String
  username     String       @unique
  email        String       @unique
  role         AuthUserRole @default(ADMIN)
  passwordHash String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([role])
  @@index([isActive])
}

model AuthLoginRateLimitBucket {
  key                    String   @id
  failedAttemptEpochMs   String[] @default([])
  lockedUntil            DateTime?
  lastSeenAt             DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([lastSeenAt])
  @@index([lockedUntil])
}

model AppThrottleBucket {
  key          String   @id
  hitEpochMs   String[] @default([])
  blockedUntil DateTime?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lastSeenAt])
  @@index([blockedUntil])
}

model MasterDataOption {
  id          String   @id @default(cuid())
  categoryKey String
  value       String
  label       String
  description String?
  metadata    Json?
  sortOrder   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryKey, value])
  @@index([categoryKey, sortOrder])
  @@index([categoryKey, isActive])
}

model Group {
  id                 String                @id @default(cuid())
  code               String                @unique
  name               String
  status             String
  lifecycleStatus    GroupLifecycleStatus  @default(ACTIVE)
  searchDocument     String                @default("")
  tone               GroupTone             @default(ACTIVE)
  arrivalDate        DateTime
  returnDate         DateTime
  pax                Int
  totalBuses         Int?
  packageName        String
  durationDays       Int
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  musyrif            Musyrif?
  nextActivity       NextActivity?
  timeline           GroupTimelineItem[]
  itinerary          ItineraryItem[]
  notes              GroupNote[]
  visaSetup          VisaSetup?
  checklistAssignments ChecklistAssignment[]
  auditLogs          GroupAuditLog[]
  invoiceClients     InvoiceClient[]
  invoices           Invoice[]
  parentGroupId      String?
  parentGroup        Group?                @relation("GroupToGroup", fields: [parentGroupId], references: [id], onDelete: SetNull)
  childGroups        Group[]               @relation("GroupToGroup")

  @@index([createdAt])
  @@index([lifecycleStatus])
}

model GroupAuditLog {
  id        String   @id @default(cuid())
  groupId   String?
  groupCode String?
  action    String
  entity    String
  payload   Json
  createdAt DateTime @default(now())
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@index([groupCode, createdAt])
  @@index([createdAt])
}

model InvoiceClient {
  id          String    @id @default(cuid())
  name        String
  sortOrder   Int
  groupId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  group       Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  invoices    Invoice[]

  @@index([sortOrder])
  @@index([name])
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  clientId       String
  groupId        String?
  issuedDate     DateTime
  dueDate        DateTime
  amount         Decimal       @default(0) @db.Decimal(12, 2)
  downPaymentIdr Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(PENDING)
  notes          String?
  items          Json?
  recipientName  String?
  version        Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  client         InvoiceClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  group          Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  itemsRel       InvoiceItem[]

  @@index([dueDate])
  @@index([clientId, dueDate])
  @@index([groupId])
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  description    String
  pax            Int
  currency       String
  unitPrice      Decimal  @db.Decimal(12, 2)
  totalPrice     Decimal  @db.Decimal(12, 2)
  totalPriceIdr  Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Musyrif {
  id        String   @id @default(cuid())
  groupId   String   @unique
  name      String
  phone     String
  avatar    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model NextActivity {
  id        String   @id @default(cuid())
  groupId   String   @unique
  title     String
  dateLabel String
  timeLabel String
  icon      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model GroupTimelineItem {
  id           String   @id @default(cuid())
  groupId      String
  sortOrder    Int
  dateLabel    String
  title        String
  isCurrent    Boolean  @default(false)
  nextActivity String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
  @@unique([groupId, sortOrder])
}

model ItineraryItem {
  id                    String   @id @default(cuid())
  groupId               String
  sortOrder             Int
  dateLabel             String
  yearLabel             String
  category              String
  categoryKey           String?
  title                 String
  meta                  String
  icon                  String
  highlighted           Boolean  @default(false)
  isoDate               DateTime?
  time                  String?
  flightNumber          String?
  hotelName             String?
  fromHotelName         String?
  fromLocation          String?
  toLocation            String?
  cityTourCity          String?
  requiresBus           Boolean  @default(false)
  notes                 String?
  transferByTrain       Boolean  @default(false)
  trainDepartureTime    String?
  destinationPickupTime String?
  hotelPickupRequestTime String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  group                 Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  checklistAssignments  ChecklistAssignment[]

  @@index([groupId, sortOrder])
  @@unique([groupId, sortOrder])
}

model GroupNote {
  id        String   @id @default(cuid())
  groupId   String
  sortOrder Int
  text      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

model VisaSetup {
  id                  String               @id @default(cuid())
  groupId             String               @unique
  visaStatus          VisaStatus           @default(DRAFT)
  issuedDate          DateTime?
  syarikah            String
  busStatus           VisaBusStatus?
  paymentStatus       VisaPaymentStatus    @default(UNPAID)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  group               Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  hotelAgreements     VisaHotelAgreement[]
  raudhahAppointments RaudhahAppointment[]
}

model VisaHotelAgreement {
  id              String                  @id @default(cuid())
  visaSetupId     String
  sourceDraftId   String?
  city            AgreementCity
  hotelName       String
  agreementNumber String
  pax             Int
  status          AgreementApprovalStatus @default(WAITING)
  stayStart       DateTime
  stayEnd         DateTime
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  visaSetup       VisaSetup               @relation(fields: [visaSetupId], references: [id], onDelete: Cascade)
  sourceDraft     HotelAgreementDraft?    @relation(fields: [sourceDraftId], references: [id], onDelete: SetNull)

  @@index([visaSetupId, city, stayStart])
  @@index([sourceDraftId])
}

model HotelAgreementDraft {
  id              String                  @id @default(cuid())
  city            AgreementCity
  agentName       String?
  hotelName       String
  agreementNumber String
  pax             Int
  status          AgreementApprovalStatus @default(WAITING)
  stayStart       DateTime
  stayEnd         DateTime
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  linkedHotelAgreements VisaHotelAgreement[]

  @@index([agreementNumber])
  @@index([city, stayStart])
}

model RaudhahAppointment {
  id         String             @id @default(cuid())
  visaSetupId String
  date       DateTime
  status     GroupRaudhahStatus @default(FREE)
  tasrehPrinted Boolean         @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  visaSetup  VisaSetup          @relation(fields: [visaSetupId], references: [id], onDelete: Cascade)

  @@index([visaSetupId, date])
}

model ChecklistAssignment {
  id                 String                    @id @default(cuid())
  groupId            String
  itineraryItemId    String?
  tripDate           DateTime
  activity           String
  tripLabel          String
  requiredBusCount   Int                       @default(1)
  scheduledTime      String
  transferByTrain    Boolean                   @default(false)
  trainDepartureTime String?
  stationPickupTime  String?
  status             ChecklistAssignmentStatus @default(NOT_COMPLETE)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  group              Group                     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  itineraryItem      ItineraryItem?            @relation(fields: [itineraryItemId], references: [id], onDelete: SetNull)
  drivers            ChecklistDriver[]

  @@index([groupId, tripDate])
}

model ChecklistDriver {
  id                    String               @id @default(cuid())
  checklistAssignmentId String
  slotNumber            Int
  name                  String
  phone                 String
  plateNumber           String
  isVerified            Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  checklistAssignment   ChecklistAssignment  @relation(fields: [checklistAssignmentId], references: [id], onDelete: Cascade)

  @@unique([checklistAssignmentId, slotNumber])
  @@index([checklistAssignmentId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupTone {
  ACTIVE
  INACTIVE
}

enum GroupLifecycleStatus {
  ENTRY_ONLY
  ACTIVE
  INACTIVE
  COMPLETED
  ARCHIVED
}

enum AgentType {
  DIRECT
  PARTNER
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

enum AgentPortalUserStatus {
  ACTIVE
  DISABLED
}

enum AgentPortalAccountAuditAction {
  CREATED
  ACTIVATED
  DISABLED
  PASSWORD_RESET
  REVOKED
}

enum VisaApplicationStatus {
  WAITING_DOCUMENT
  NEED_REVISION
  DOCUMENT_VERIFIED
  WAITING_HOTEL_AGREEMENT
  PASSENGER_ENTERED
  GROUP_CREATED
  READY_TO_SEND
  VISA_SUBMITTED
  PAYMENT_COMPLETED
  VISA_PROCESSING
  VISA_ISSUED
  COMPLETED
}

enum VisaApplicationDocumentStatus {
  WAITING_DOCUMENT
  NEED_REVISION
  VERIFIED
}

enum VisaApplicationAgreementStatus {
  NOT_STARTED
  WAITING_APPROVAL
  APPROVED
}

enum VisaApplicationNusukStatus {
  NOT_STARTED
  PASSENGER_ENTRY
  PASSENGER_ENTERED
  GROUP_CREATED
}

enum VisaApplicationPaymentStatus {
  NOT_STARTED
  WAITING_PAYMENT
  COMPLETED
}

enum VisaApplicationVisaStatus {
  NOT_STARTED
  READY_TO_SEND
  SUBMITTED
  PROCESSING
  ISSUED
  COMPLETED
}

enum VisaApplicationDocumentType {
  PASSPORT
  VACCINE_CERTIFICATE
  MANIFEST
  PACKAGE_INFORMATION
}

enum VisaStatus {
  DRAFT
  PENDING
  ISSUED
}

enum VisaPaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

enum VisaBusStatus {
  VISA_ONLY
  VISA_PLUS
}

enum AgreementApprovalStatus {
  WAITING
  APPROVED
  REJECTED
}


enum AgreementCity {
  MAKKAH
  MADINAH
}

enum GroupRaudhahStatus {
  FREE
  AFTER
  BEFORE
}

enum ChecklistAssignmentStatus {
  NOT_COMPLETE
  ASSIGNED
}

enum InvoiceStatus {
  PAID
  PARTIALLY_PAID
  PENDING
  OVERDUE
  CANCELLED
}

enum AuthUserRole {
  SUPER_ADMIN
  ADMIN
  FINANCE_MANAGER
  CUSTOMER_SUPPORT
}

model AuthUser {
  id           String       @id @default(cuid())
  name         String
  username     String       @unique
  email        String       @unique
  role         AuthUserRole @default(ADMIN)
  passwordHash String?
  isActive     Boolean      @default(true)
  tokenVersion Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  agentPortalAccountAuditLogs AgentPortalAccountAuditLog[]
  visaApplicationProgressAuditLogs VisaApplicationProgressAuditLog[]

  @@index([role])
  @@index([isActive])
}

model AuthLoginRateLimitBucket {
  key                    String   @id
  failedAttemptEpochMs   String[] @default([])
  lockedUntil            DateTime?
  lastSeenAt             DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([lastSeenAt])
  @@index([lockedUntil])
}

model AppThrottleBucket {
  key          String   @id
  hitEpochMs   String[] @default([])
  blockedUntil DateTime?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lastSeenAt])
  @@index([blockedUntil])
}

model MasterDataOption {
  id          String   @id @default(cuid())
  categoryKey String
  value       String
  label       String
  description String?
  metadata    Json?
  sortOrder   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryKey, value])
  @@index([categoryKey, sortOrder])
  @@index([categoryKey, isActive])
}

model Muassasah {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  drivers   Driver[]
  vehicles  Vehicle[]

  @@index([isActive])
}

model Driver {
  id            String     @id @default(cuid())
  name          String
  phone         String?
  note          String?
  isProblematic Boolean    @default(false)
  isActive      Boolean    @default(true)
  muassasahId   String?
  muassasah     Muassasah? @relation(fields: [muassasahId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([muassasahId])
  @@index([isActive])
  @@index([name])
}

model Vehicle {
  id            String     @id @default(cuid())
  plateNumber   String
  note          String?
  isProblematic Boolean    @default(false)
  isActive      Boolean    @default(true)
  muassasahId   String?
  muassasah     Muassasah? @relation(fields: [muassasahId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([muassasahId])
  @@index([isActive])
  @@index([plateNumber])
}

model Agent {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  type      AgentType   @default(PARTNER)
  status    AgentStatus @default(ACTIVE)
  picName   String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  groups    Group[]
  hotelAgreementDrafts HotelAgreementDraft[]
  invoices  Invoice[]
  portalUsers AgentPortalUser[]
  portalAccountAuditLogs AgentPortalAccountAuditLog[]
  visaApplications VisaApplication[]

  @@index([name])
  @@index([status, type])
}

model AgentPortalUser {
  id                   String                @id @default(cuid())
  agentId              String
  displayName          String
  email                String
  normalizedIdentifier String                @unique
  passwordHash         String
  status               AgentPortalUserStatus @default(ACTIVE)
  mustChangePassword   Boolean               @default(true)
  tokenVersion         Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  agent                Agent                 @relation(fields: [agentId], references: [id], onDelete: Restrict)
  auditLogs            AgentPortalAccountAuditLog[]
  visaApplications     VisaApplication[]

  @@index([agentId, status])
}

model VisaApplication {
  id                   String                          @id @default(cuid())
  applicationNumber    String                          @unique
  agentId              String
  groupId              String?                         @unique
  createdByPortalUserId String
  departureDate        DateTime
  returnDate           DateTime
  departureCity        String
  providerName         String?
  packageName          String
  passengerCount       Int
  status               VisaApplicationStatus           @default(WAITING_DOCUMENT)
  documentStatus       VisaApplicationDocumentStatus   @default(WAITING_DOCUMENT)
  agreementStatus      VisaApplicationAgreementStatus  @default(NOT_STARTED)
  nusukStatus          VisaApplicationNusukStatus      @default(NOT_STARTED)
  paymentStatus        VisaApplicationPaymentStatus    @default(NOT_STARTED)
  visaStatus           VisaApplicationVisaStatus       @default(NOT_STARTED)
  nusukGroupNumber     String?
  nusukReferenceNumber String?
  adminNote            String?
  submittedAt          DateTime?
  completedAt          DateTime?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  agent                Agent                           @relation(fields: [agentId], references: [id], onDelete: Restrict)
  group                Group?                          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdByPortalUser  AgentPortalUser                 @relation(fields: [createdByPortalUserId], references: [id], onDelete: Restrict)
  documents            VisaApplicationDocument[]
  progressAuditLogs    VisaApplicationProgressAuditLog[]

  @@index([agentId, createdAt(sort: Desc)])
  @@index([agentId, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
}

model VisaApplicationProgressAuditLog {
  id                String          @id @default(cuid())
  visaApplicationId String
  actorAuthUserId   String
  action            String
  changes           Json
  createdAt         DateTime        @default(now())
  visaApplication   VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)
  actorAuthUser     AuthUser        @relation(fields: [actorAuthUserId], references: [id], onDelete: Restrict)

  @@index([visaApplicationId, createdAt(sort: Desc)])
  @@index([actorAuthUserId, createdAt(sort: Desc)])
}

model VisaApplicationDocument {
  id                String                        @id @default(cuid())
  visaApplicationId String
  type              VisaApplicationDocumentType
  originalName      String
  mimeType          String
  sizeBytes         Int
  storageKey        String
  status            VisaApplicationDocumentStatus @default(WAITING_DOCUMENT)
  reviewNote        String?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  visaApplication   VisaApplication               @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)

  @@unique([visaApplicationId, type])
  @@index([visaApplicationId, status])
}

model AgentPortalAccountAuditLog {
  id              String                        @id @default(cuid())
  portalUserId    String?
  agentId         String
  actorAuthUserId String?
  action          AgentPortalAccountAuditAction
  createdAt       DateTime                      @default(now())
  portalUser      AgentPortalUser?              @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  agent           Agent                         @relation(fields: [agentId], references: [id], onDelete: Restrict)
  actorAuthUser   AuthUser?                      @relation(fields: [actorAuthUserId], references: [id], onDelete: SetNull)

  @@index([portalUserId, createdAt])
  @@index([agentId, createdAt])
  @@index([actorAuthUserId, createdAt])
}

model Group {
  id                 String                @id @default(cuid())
  code               String                @unique
  name               String
  status             String
  lifecycleStatus    GroupLifecycleStatus  @default(ACTIVE)
  searchDocument     String                @default("")
  tone               GroupTone             @default(ACTIVE)
  arrivalDate        DateTime
  returnDate         DateTime
  pax                Int
  totalBuses         Int?
  packageName        String
  durationDays       Int
  agentId            String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  musyrif            Musyrif?
  nextActivity       NextActivity?
  timeline           GroupTimelineItem[]
  itinerary          ItineraryItem[]
  notes              GroupNote[]
  visaSetup          VisaSetup?
  checklistAssignments ChecklistAssignment[]
  auditLogs          GroupAuditLog[]
  invoiceClients     InvoiceClient[]
  invoices           Invoice[]
  parentGroupId      String?
  parentGroup        Group?                @relation("GroupToGroup", fields: [parentGroupId], references: [id], onDelete: SetNull)
  childGroups        Group[]               @relation("GroupToGroup")
  agent              Agent                 @relation(fields: [agentId], references: [id], onDelete: Restrict)
  visaApplication    VisaApplication?

  @@index([createdAt])
  @@index([lifecycleStatus])
  @@index([searchDocument, lifecycleStatus])
  @@index([parentGroupId])
  @@index([agentId, lifecycleStatus, arrivalDate])
  @@index([searchDocument(ops: raw("gin_trgm_ops"))], type: Gin)
}

model GroupAuditLog {
  id        String   @id @default(cuid())
  groupId   String?
  groupCode String?
  action    String
  entity    String
  payload   Json
  createdAt DateTime @default(now())
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@index([groupCode, createdAt])
  @@index([createdAt])
}

model InvoiceClient {
  id          String    @id @default(cuid())
  name        String
  sortOrder   Int
  groupId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  group       Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  invoices    Invoice[]

  @@index([sortOrder])
  @@index([name])
  @@index([groupId])
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  clientId       String
  groupId        String?
  agentId        String
  issuedDate     DateTime
  dueDate        DateTime
  amount         Decimal       @default(0) @db.Decimal(12, 2)
  downPaymentIdr Decimal       @default(0) @db.Decimal(12, 2)
  discountIdr    Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(PENDING)
  notes          String?
  description    String?
  recipientName  String?
  version        Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  client         InvoiceClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  group          Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  agent          Agent         @relation(fields: [agentId], references: [id], onDelete: Restrict)
  items          Json?
  itemsRel       InvoiceItem[]

  @@index([dueDate])
  @@index([clientId, dueDate])
  @@index([groupId])
  @@index([agentId, status, dueDate(sort: Desc)])
  @@index([status, dueDate(sort: Desc)])
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  description    String
  pax            Int
  currency       String
  unitPrice      Decimal  @db.Decimal(12, 2)
  totalPrice     Decimal  @db.Decimal(12, 2)
  totalPriceIdr  Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, description])
}

model Musyrif {
  id        String   @id @default(cuid())
  groupId   String   @unique
  name      String
  phone     String
  avatar    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model NextActivity {
  id        String   @id @default(cuid())
  groupId   String   @unique
  title     String
  dateLabel String
  timeLabel String
  icon      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model GroupTimelineItem {
  id           String   @id @default(cuid())
  groupId      String
  sortOrder    Int
  dateLabel    String
  title        String
  isCurrent    Boolean  @default(false)
  nextActivity String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, sortOrder])
}

model ItineraryItem {
  id                    String   @id @default(cuid())
  groupId               String
  sortOrder             Int
  dateLabel             String
  yearLabel             String
  category              String
  categoryKey           String?
  title                 String
  meta                  String
  icon                  String
  highlighted           Boolean  @default(false)
  isoDate               DateTime?
  time                  String?
  transportMode         String?
  flightNumber          String?
  hotelName             String?
  fromHotelName         String?
  fromLocation          String?
  toLocation            String?
  cityTourCity          String?
  requiresBus           Boolean  @default(false)
  notes                 String?
  transferByTrain       Boolean  @default(false)
  trainDepartureTime    String?
  destinationPickupTime String?
  hotelPickupRequestTime String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  group                 Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  checklistAssignments  ChecklistAssignment[]

  @@unique([groupId, sortOrder])
  @@index([isoDate])
}

model GroupNote {
  id        String   @id @default(cuid())
  groupId   String
  sortOrder Int
  text      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

model VisaSetup {
  id                  String               @id @default(cuid())
  groupId             String               @unique
  visaStatus          VisaStatus           @default(DRAFT)
  issuedDate          DateTime?
  syarikah            String
  busStatus           VisaBusStatus?
  paymentStatus       VisaPaymentStatus    @default(UNPAID)
  makkahHotelWaived   Boolean              @default(false)
  madinahHotelWaived  Boolean              @default(false)
  arrivalFlightNumber String?
  arrivalTime         String?
  departureFlightNumber String?
  departureTime       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  group               Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  hotelAgreements     VisaHotelAgreement[]
  raudhahAppointments RaudhahAppointment[]
}

model VisaHotelAgreement {
  id              String                  @id @default(cuid())
  visaSetupId     String
  sourceDraftId   String?
  city            AgreementCity
  hotelName       String
  agreementNumber String
  pax             Int
  status          AgreementApprovalStatus @default(WAITING)
  stayStart       DateTime
  stayEnd         DateTime
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  visaSetup       VisaSetup               @relation(fields: [visaSetupId], references: [id], onDelete: Cascade)
  sourceDraft     HotelAgreementDraft?    @relation(fields: [sourceDraftId], references: [id], onDelete: SetNull)

  @@index([visaSetupId, city, stayStart])
  @@index([sourceDraftId])
  @@unique([sourceDraftId, visaSetupId])
}

model HotelAgreementDraft {
  id              String                  @id @default(cuid())
  city            AgreementCity
  agentId         String
  groupName       String                  @default("")
  hotelName       String
  agreementNumber String
  pax             Int
  status          AgreementApprovalStatus @default(WAITING)
  stayStart       DateTime
  stayEnd         DateTime
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  linkedHotelAgreements VisaHotelAgreement[]
  agent           Agent                   @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([agreementNumber])
  @@index([city, stayStart])
  @@index([agentId, city, stayStart])
}

model RaudhahAppointment {
  id         String             @id @default(cuid())
  visaSetupId String
  date       DateTime
  status     GroupRaudhahStatus @default(FREE)
  tasrehPrinted Boolean         @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  visaSetup  VisaSetup          @relation(fields: [visaSetupId], references: [id], onDelete: Cascade)

  @@index([visaSetupId, date])
}

model ChecklistAssignment {
  id                 String                    @id @default(cuid())
  groupId            String
  itineraryItemId    String?
  tripDate           DateTime
  activity           String
  tripLabel          String
  requiredBusCount   Int                       @default(1)
  scheduledTime      String
  transferByTrain    Boolean                   @default(false)
  trainDepartureTime String?
  stationPickupTime  String?
  status             ChecklistAssignmentStatus @default(NOT_COMPLETE)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  group              Group                     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  itineraryItem      ItineraryItem?            @relation(fields: [itineraryItemId], references: [id], onDelete: SetNull)
  drivers            ChecklistDriver[]

  @@index([groupId, tripDate])
  @@index([itineraryItemId])
}

model ChecklistDriver {
  id                    String               @id @default(cuid())
  checklistAssignmentId String
  slotNumber            Int
  name                  String
  phone                 String
  plateNumber           String
  isVerified            Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  checklistAssignment   ChecklistAssignment  @relation(fields: [checklistAssignmentId], references: [id], onDelete: Cascade)

  @@unique([checklistAssignmentId, slotNumber])
}

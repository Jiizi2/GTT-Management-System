{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "predev": "node scripts/release-dev-port.js",
    "dev": "node scripts/dev.js",
    "start": "node dist/main.js",
    "auth:bootstrap:superadmin": "node dist/bootstrap-super-admin.js",
    "check": "tsc --noEmit -p tsconfig.json --tsBuildInfoFile tsconfig.check.tsbuildinfo",
    "check:test": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:unit:watch": "vitest --config vitest.config.mts",
    "test:unit:coverage": "vitest run --config vitest.config.mts --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=html --coverage.reporter=lcov --coverage.reportsDirectory=../../coverage/unit/backend",
    "test:unit:coverage:check": "vitest run --config vitest.config.mts --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=html --coverage.reporter=lcov --coverage.reportsDirectory=../../coverage/unit/backend --coverage.thresholds.lines=60 --coverage.thresholds.functions=68 --coverage.thresholds.branches=62 --coverage.thresholds.statements=60",
    "test:integration": "npm run db:deploy && npm run build && node dist/e2e/backend.prisma.integration.test.js && node dist/e2e/backend.prisma.groups.integration.test.js",
    "test:api": "npm run build && node dist/e2e/backend.api.e2e.test.js",
    "test": "npm run test:unit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:status": "prisma migrate status --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "prisma db seed --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.16.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "joi": "^18.1.2",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.16.2",
    "supertest": "^7.2.2",
    "vitest": "^4.1.4"
  }
}

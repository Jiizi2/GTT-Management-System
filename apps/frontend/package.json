{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean-output.mjs dist build-meta",
    "clean:build": "node scripts/clean-output.mjs dist build-meta",
    "build": "npm run check:icons && npm run clean:build && tsc --noEmit -p tsconfig.json && npm run build:css && npm run build:js && node -e \"const fs=require('fs'); const path=require('path'); const copy=(src,dst)=>{const stat=fs.statSync(src); if(stat.isDirectory()){fs.mkdirSync(dst,{recursive:true}); for(const entry of fs.readdirSync(src)){copy(path.join(src,entry),path.join(dst,entry));} return;} fs.mkdirSync(path.dirname(dst),{recursive:true}); fs.copyFileSync(src,dst);}; copy('public','dist');\" && node scripts/runtime-config.mjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/styles.css -o dist/index.css --minify",
    "build:js": "esbuild src/index.tsx --bundle --format=esm --platform=browser --target=es2022 --jsx=automatic --splitting --minify --outdir=dist --entry-names=index --chunk-names=chunks/[name]-[hash] --metafile=build-meta/esbuild-meta.json",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "build:analyze": "npm run build && npm run analyze:bundle",
    "assets:icons": "node scripts/update-material-symbols-subset.mjs",
    "check:icons": "node scripts/update-material-symbols-subset.mjs --check",
    "predev": "node scripts/release-dev-port.cjs",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:write": "npm run format",
    "check": "npm run check:icons && tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --config vitest.config.mts src/unit",
    "test:unit:watch": "vitest --config vitest.config.mts src/unit",
    "test:unit:coverage": "vitest run --config vitest.config.mts src/unit --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=html --coverage.reporter=lcov --coverage.reportsDirectory=../../coverage/unit/frontend",
    "test:unit:coverage:check": "vitest run --config vitest.config.mts src/unit --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=html --coverage.reporter=lcov --coverage.reportsDirectory=../../coverage/unit/frontend --coverage.thresholds.lines=38 --coverage.thresholds.functions=36 --coverage.thresholds.branches=31 --coverage.thresholds.statements=38",
    "test:smoke": "vitest run --config vitest.config.mts src/smoke",
    "test:smoke:watch": "vitest --config vitest.config.mts src/smoke",
    "test:smoke:coverage": "vitest run --config vitest.config.mts src/smoke --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=html --coverage.reporter=lcov --coverage.reportsDirectory=../../coverage/smoke/frontend",
    "test:component": "vitest run --config vitest.component.config.mts src/components",
    "test:component:watch": "vitest --config vitest.component.config.mts src/components",
    "test:component:coverage": "vitest run --config vitest.component.config.mts src/components --coverage.enabled",
    "test": "npm run test:unit",
    "test:e2e": "playwright test e2e/app.e2e.spec.ts",
    "test:e2e:diagnostics": "playwright test e2e/diagnostics.spec.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.97.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "react-router-dom": "^7.14.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.5.0",
    "jsdom": "^22.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.2",
    "tailwindcss": "^3.4.17",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  }
}

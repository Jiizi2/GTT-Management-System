# Frontend production runtime/build hints
# The frontend build/dev scripts emit dist/runtime-config.js from GTT_API_BASE_URL.
# Set this before building the frontend if the API lives on another domain.
# The app still falls back to same-origin /api when no custom base URL is provided.

NODE_ENV=production
HOST=0.0.0.0
PORT=4173
GTT_API_BASE_URL="https://api.example.com/api"

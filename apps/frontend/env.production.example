# Frontend production runtime/build hints
# This project resolves API base URL from window.__GTT_API_BASE_URL__ or same-origin /api.
# Set these variables in your deployment platform and inject __GTT_API_BASE_URL__ at runtime if API is on another domain.

NODE_ENV=production
HOST=0.0.0.0
PORT=4173
GTT_API_BASE_URL="https://api.example.com/api"

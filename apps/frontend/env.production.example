# Frontend production runtime/build hints
# The frontend build/dev scripts emit dist/runtime-config.js from GTT_API_BASE_URL.
# Set this before building if the API does not use same-origin /api.
# Preferred deployments for cookie auth are:
# - same-origin, or
# - same-site subdomains such as app.example.com -> api.example.com
# If you point this to another origin, backend CORS_ORIGINS must explicitly allow the
# frontend origin because auth browser requests use credentials/cookies.
# For subdomain deployments, backend may also need AUTH_COOKIE_DOMAIN=.example.com.

NODE_ENV=production
HOST=0.0.0.0
PORT=4173
GTT_API_BASE_URL="https://api.example.com/api"
